    "@twemoji/svg": "^15.0.0",
    "alpinejs": "^3.17.5",
    "budoux": "^0.10.1",
    "unpoly": "^3.15.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "serwist": "^9.5.13"
  }
}
