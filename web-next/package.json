{
  "name": "sukhi-web-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:sw": "node scripts/build-sw.mjs",
    "dev": "node scripts/build-sw.mjs && node --watch server/main.ts",
