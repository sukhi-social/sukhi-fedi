#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Sourced by the release's own boot script before the BEAM starts —
# for `start`, for `eval`, for `rpc`, for every one of them. That is the
# only place *every* way of launching this release passes through, which
# is why the two things that must never be skipped live here rather than
# in entrypoint.sh:
#
#   1. the distribution cookie, fail-closed
#   2. "which node is the api plugin?" — this one
#
# Under DeployEx there is no entrypoint.sh at all. DeployEx unsets every
# RELEASE_* variable it can see, exports RELEASE_NODE=<sname>, and execs
# bin/combined directly. Anything left in entrypoint.sh would simply not
# happen there.
#
# Note the ordering in bin/combined: this file is sourced *before* the
# script fills in its own defaults for RELEASE_COOKIE / RELEASE_NODE /
# RELEASE_DISTRIBUTION, so all three may still be unset here.

# ERLANG_COOKIE → RELEASE_COOKIE. Kamal env can't do variable indirection,
# and DeployEx strips RELEASE_* on the way in, so the cookie has to arrive
# under a name that survives both.
if [ -n "${ERLANG_COOKIE:-}" ] && [ -z "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE="$ERLANG_COOKIE"
fi

# Fail closed. The cookie is the only authentication Erlang distribution
# has. With none set, bin/combined would happily fall back to the random
# one baked into releases/COOKIE and nothing would look wrong — until
# DeployEx (or the other half of a cluster) could not reach us.
if [ -z "${RELEASE_COOKIE:-}" ] || [ "${RELEASE_COOKIE:-}" = "sukhi_fedi_dev_cookie" ]; then
  echo "[env.sh] refusing to boot: set ERLANG_COOKIE to a random secret (openssl rand -hex 32)" >&2
  exit 1
fi

# gateway ↔ api talk over :rpc (ARCHITECTURE §2 rule 6). In this release
# both live in the same BEAM, so each one's "the other node" is us.
# `:=` means an explicitly set value always wins — the multi-container
# compose stack passes PLUGIN_NODES=api@api and never reaches this.
_sukhi_dist="${RELEASE_DISTRIBUTION:-sname}"
_sukhi_node="${RELEASE_NODE:-$RELEASE_NAME}"
case "$_sukhi_dist" in
  sname) _sukhi_self="${_sukhi_node}@$(hostname -s)" ;;
  name)  _sukhi_self="${_sukhi_node}" ;;
  *)     _sukhi_self="" ;;
esac
if [ -n "$_sukhi_self" ]; then
  : "${PLUGIN_NODES:=$_sukhi_self}"
  : "${GATEWAY_NODE:=$_sukhi_self}"
  export PLUGIN_NODES GATEWAY_NODE
fi
unset _sukhi_dist _sukhi_node _sukhi_self

# DeployEx's own release always boots distribution over mutual TLS: its
# env.sh writes /tmp/inet_tls.conf unconditionally and passes
# -proto_dist inet_tls. Two nodes can only see each other if they agree,
# so join it when that file is there, and stay on plain distribution when
# it isn't (compose, `make dev`, the free-tier box).
if [ -f /tmp/inet_tls.conf ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet_tls -ssl_dist_optfile /tmp/inet_tls.conf"
fi
