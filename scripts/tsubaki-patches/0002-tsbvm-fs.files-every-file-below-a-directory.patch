From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 14:39:08 +0000
Subject: [PATCH 2/2] tsbvm: fs.files -- every file below a directory

Needed by scripts that audit a source tree (sukhi-fedi's env_audit.jl,
oban_queues_check.jl). Sorted, depth first; a symlink to a directory is
not followed, a symlink to a file is listed; a missing directory is an
error.
---
 tsbvm/src/host.rs                   |  26 ++++++++++++++++++++++++++
 tsbvm/tests/fixtures/host_files.jl  |  18 ++++++++++++++++++
 tsbvm/tests/fixtures/host_files.tsb | Bin 0 -> 918 bytes
 tsbvm/tests/host.rs                 |  12 ++++++++++++
 4 files changed, 56 insertions(+)
 create mode 100644 tsbvm/tests/fixtures/host_files.jl
 create mode 100644 tsbvm/tests/fixtures/host_files.tsb

diff --git a/tsbvm/src/host.rs b/tsbvm/src/host.rs
index d75277c..5035598 100644
--- a/tsbvm/src/host.rs
+++ b/tsbvm/src/host.rs
@@ -10,6 +10,8 @@
 //!
 //!   env.get(name, default)            string | default
 //!   fs.dirs(path)                     [string]   sub-directories, sorted
+//!   fs.files(path)                    [string]   every file below it, as
+//!                                                path + "/" + relative; sorted
 //!   fs.exists(path)                   bool
 //!   fs.read(path)                     string
 //!   fs.write(path, text)              nothing
@@ -74,6 +76,14 @@ impl Host for StdHost {
                 let quoted: Vec<String> = names.iter().map(|n| json::quote(n)).collect();
                 Ok(format!("[{}]", quoted.join(",")))
             }
+            "fs.files" => {
+                let path = text(&args, 0, "path")?;
+                let mut found = Vec::new();
+                walk(Path::new(&path), &mut found).or_else(|e| fail(format!("walk {path}: {e}")))?;
+                found.sort();
+                let quoted: Vec<String> = found.iter().map(|n| json::quote(n)).collect();
+                Ok(format!("[{}]", quoted.join(",")))
+            }
             "fs.exists" => {
                 let path = text(&args, 0, "path")?;
                 Ok(Path::new(&path).exists().to_string())
@@ -145,6 +155,22 @@ impl Host for StdHost {
     }
 }
 
+/// Every regular file below `dir`, depth first. A symlink to a directory is
+/// not followed (a loop would never end), but a symlink to a file is listed.
+fn walk(dir: &Path, out: &mut Vec<String>) -> std::io::Result<()> {
+    for entry in std::fs::read_dir(dir)? {
+        let entry = entry?;
+        let path = entry.path();
+        let kind = entry.file_type()?;
+        if kind.is_dir() {
+            walk(&path, out)?;
+        } else {
+            out.push(path.to_string_lossy().into_owned());
+        }
+    }
+    Ok(())
+}
+
