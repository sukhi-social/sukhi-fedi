;; SPDX-License-Identifier: AGPL-3.0-or-later
;;
;; sukhi-fedi  Datalevin schema (revision 1 of ひなた's draft)
;; 経緯と理由は docs/DATALEVIN_SCHEMA.md。dtlv 1.2.10 で読み込みと下記の動作を確認済み。
;;
;; 配送キューは SQLite 側。ここには持たない。
;; 層: A = グラフの芯(この表で作り直す) / B = 運用・ローカルアカウント(カタログから機械的に写す。ここには書かない)
;;
;; 時刻(*/published など)は :db.type/long、Unix epoch からのマイクロ秒。MCP の JSON では instant を書けない(実測: "Expect java.util.Date")ため、
;; 既存の Datalevin ストア(SukhiFedi.Datalevin.Types)と同じ約束に揃えた。
;;
;; 読み書きの約束(実測で踏んだもの):
;;  - tuple の範囲検索 (index-range) の境界は lookup ref ではなく eid。先に actor の eid を引く。
;;  - tuple の部品が nil でも tuple は作られる(その行は [x nil] として索引に入る)。
;;  - 全文検索は :db.fulltext/autoDomain が無いと (fulltext $ :attr "q") が例外になる。
;;  - 既定の分かち書きは日本語を切らない。「猫」で「日本語の猫」は当たらない(docs 参照)。

{;; ───────── Actor ─────────
 :actor/id           {:db/valueType :db.type/string :db/unique :db.unique/identity} ;; IRI
 :actor/did          {:db/valueType :db.type/string :db/unique :db.unique/identity} ;; did:key 系。id と did が別 entity に付くと upsert 衝突する(取り込みで統合する)
 :actor/sid          {:db/valueType :db.type/long   :db/unique :db.unique/identity} ;; API 用の安定 ID(アプリ側で採番。eid は再構築で変わる)
 :actor/gateway      {:db/valueType :db.type/string :db/cardinality :db.cardinality/many}
 :actor/local?       {:db/valueType :db.type/boolean}
 :actor/username     {:db/valueType :db.type/string}
 :actor/host         {:db/valueType :db.type/string}
 :actor/name         {:db/valueType :db.type/string}
 :actor/summary      {:db/valueType :db.type/string}
 :actor/avatar       {:db/valueType :db.type/string}
 :actor/banner       {:db/valueType :db.type/string}
 :actor/bot?         {:db/valueType :db.type/boolean}
 :actor/type         {:db/valueType :db.type/keyword} ;; :Person :Group :Service … (JSON-LD の @type。板は :Group)
 :actor/suspended-at {:db/valueType :db.type/long}
 :actor/inbox        {:db/valueType :db.type/string}
 :actor/outbox       {:db/valueType :db.type/string}
 :actor/shared-inbox {:db/valueType :db.type/string}
 :actor/raw          {:db/valueType :db.type/string}
 :actor/raw-ref      {:db/valueType :db.type/string}
 :actor/fetched-at   {:db/valueType :db.type/long}
 :actor/handle       {:db/valueType :db.type/tuple
                      :db/tupleAttrs [:actor/username :actor/host]
                      :db/unique :db.unique/identity} ;; @user@host の一意。ローカルは host = nil

 ;; ───────── Key ─────────
 :key/id         {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :key/actor      {:db/valueType :db.type/ref}
 :key/type       {:db/valueType :db.type/keyword}
 :key/public     {:db/valueType :db.type/string}
 :key/private    {:db/valueType :db.type/string} ;; ローカルの秘密鍵(JWK の JSON)。RSA と Ed25519(:key/type :Multikey)の 2 本。読み出しは RpcGate の秘匿の対象
 :key/revoked-at {:db/valueType :db.type/long}

 ;; ───────── アドレス先(to/cc の行き先で actor 以外) ─────────
 ;; as:Public と各 actor の followers/following は entity にして ref で指す。
 ;; to/cc は actor でも collection でも指せる(ref は種類を問わない)。
 :collection/id    {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :collection/kind  {:db/valueType :db.type/keyword} ;; :public :followers :following :other
 :collection/owner {:db/valueType :db.type/ref}

 ;; ───────── Object ─────────
 :object/id            {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :object/sid           {:db/valueType :db.type/long   :db/unique :db.unique/identity} ;; ページ送りと API の ID
 :object/type          {:db/valueType :db.type/keyword}
 :object/attributed-to {:db/valueType :db.type/ref}
 :object/local?        {:db/valueType :db.type/boolean}
 :object/published     {:db/valueType :db.type/long}
 :object/updated       {:db/valueType :db.type/long}
 :object/received-at   {:db/valueType :db.type/long}
 :object/fetched-at    {:db/valueType :db.type/long}
 :object/touched-at    {:db/valueType :db.type/long} ;; 最後に読まれた/配られた時刻。掃除の猶予の基準(保持の理由は保存せず、掃除のときに Datalog で導く)
 :object/in-reply-to   {:db/valueType :db.type/ref}
 :object/root          {:db/valueType :db.type/ref}   ;; スレッドの根(Postgres の conversation_ap_id の代わり)
 :object/quote-of      {:db/valueType :db.type/ref}
 :object/to            {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :object/cc            {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :object/visibility    {:db/valueType :db.type/keyword} ;; 取り込み時に to/cc から導く。索引用の写し
 :object/mentions      {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :object/emojis        {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :object/title         {:db/valueType :db.type/string}
 :object/content-html  {:db/valueType :db.type/string} ;; HTML(表示用)
 :object/content-mfm   {:db/valueType :db.type/string} ;; Misskey のソース(MFM)があるときだけ。HTML だけの投稿には付けない
 :object/tokens        {:db/valueType :db.type/string :db/fulltext true :db.fulltext/autoDomain true} ;; 検索用。本文を分かち書きして空白区切りにしたもの。クエリも同じ分かち書きをかける
 :object/summary       {:db/valueType :db.type/string} ;; CW
 :object/sensitive?    {:db/valueType :db.type/boolean}
 :object/language      {:db/valueType :db.type/string}
 ;; 原本は必須。小さければ raw に直接、大きければ内容アドレスのポインタ(raw-ref)。どちらか一方だけが付く。
 ;; 書き分けは RawStore.put の 1 か所だけが決める(docs/DATALEVIN_SCHEMA.md「大きい raw」)。
 :object/raw           {:db/valueType :db.type/string} ;; FEP-8b32 の証明検証と転送の原本(閾値以下)
 :object/raw-ref       {:db/valueType :db.type/string} ;; "sha256:<hex>"。blob 側のキー
 :object/raw-size      {:db/valueType :db.type/long}
 :object/proof-verified? {:db/valueType :db.type/boolean}
 :object/proof-key     {:db/valueType :db.type/ref}
 :object/deleted-at    {:db/valueType :db.type/long} ;; Tombstone。中身は消して印だけ残す

 ;; 時系列の索引。範囲検索は eid で: (index-range db :object/author+published [aid t0] [aid t1])
 :object/author+published {:db/valueType :db.type/tuple :db/tupleAttrs [:object/attributed-to :object/published]}
 :object/vis+published    {:db/valueType :db.type/tuple :db/tupleAttrs [:object/visibility :object/published]}
 :object/local+published  {:db/valueType :db.type/tuple :db/tupleAttrs [:object/local? :object/published]} ;; ローカルタイムライン
 :object/root+published   {:db/valueType :db.type/tuple :db/tupleAttrs [:object/root :object/published]}   ;; スレッド表示
 :object/root+local       {:db/valueType :db.type/tuple :db/tupleAttrs [:object/root :object/local?]}      ;; 掃除: スレッドにローカルの参加者がいるか

 ;; ───────── 多言語本文(contentMap が来たときだけ展開) ─────────
 :content/object {:db/valueType :db.type/ref}
 :content/lang   {:db/valueType :db.type/string}
 :content/kind   {:db/valueType :db.type/keyword} ;; :content :summary :name
 :content/text   {:db/valueType :db.type/string}
 :content/tokens {:db/valueType :db.type/string :db/fulltext true :db.fulltext/autoDomain true} ;; text の分かち書き
 :content/key    {:db/valueType :db.type/tuple
                  :db/tupleAttrs [:content/object :content/lang :content/kind]
                  :db/unique :db.unique/identity}

 ;; ───────── Activity ─────────
 ;; Postgres の boosts は type = :Announce の activity、reactions の Like 系は :Like / :EmojiReact。
 :activity/id        {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :activity/type      {:db/valueType :db.type/keyword}
 :activity/actor     {:db/valueType :db.type/ref}
 :activity/object    {:db/valueType :db.type/ref} ;; object か actor
 :activity/published {:db/valueType :db.type/long}
 :activity/local?    {:db/valueType :db.type/boolean}
 :activity/raw       {:db/valueType :db.type/string}
 :activity/raw-ref   {:db/valueType :db.type/string}
 :activity/actor+published {:db/valueType :db.type/tuple :db/tupleAttrs [:activity/actor :activity/published]}
 ;; 「この人はこれをブーストしたか」を引く索引。identity にはしない(Create は object が毎回違い、Undo で消える種類もある)
 :activity/actor+type+object {:db/valueType :db.type/tuple :db/tupleAttrs [:activity/actor :activity/type :activity/object]}
 :activity/object+type {:db/valueType :db.type/tuple :db/tupleAttrs [:activity/object :activity/type]} ;; ブースト数・いいね数

 ;; ───────── Follow ─────────
 ;; follow_requests(受信待ち)と follows を 1 つにし、state で分ける。
 :follow/follower {:db/valueType :db.type/ref}
 :follow/followee {:db/valueType :db.type/ref}
 :follow/state    {:db/valueType :db.type/keyword} ;; :pending :accepted
 :follow/activity {:db/valueType :db.type/ref}
 :follow/at       {:db/valueType :db.type/long}
 :follow/pair     {:db/valueType :db.type/tuple
                   :db/tupleAttrs [:follow/follower :follow/followee]
                   :db/unique :db.unique/identity}
 :follow/followee+state {:db/valueType :db.type/tuple :db/tupleAttrs [:follow/followee :follow/state]}
 :follow/follower+state {:db/valueType :db.type/tuple :db/tupleAttrs [:follow/follower :follow/state]}

 ;; ───────── Emoji / Reaction ─────────
 :emoji/id         {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :emoji/name       {:db/valueType :db.type/string}
 :emoji/host       {:db/valueType :db.type/string}
 :emoji/image-url  {:db/valueType :db.type/string}
 :emoji/static-url {:db/valueType :db.type/string}
 :emoji/category   {:db/valueType :db.type/string}
 :emoji/updated-at {:db/valueType :db.type/long}

 :reaction/id      {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :reaction/actor   {:db/valueType :db.type/ref}
 :reaction/object  {:db/valueType :db.type/ref}
 :reaction/emoji   {:db/valueType :db.type/ref}
 :reaction/key     {:db/valueType :db.type/string} ;; "u:❤" / "e:<emoji IRI>"。異体字セレクタは保存時に揃える
 :reaction/at      {:db/valueType :db.type/long}
 :reaction/uniq    {:db/valueType :db.type/tuple
                    :db/tupleAttrs [:reaction/actor :reaction/object :reaction/key]
                    :db/unique :db.unique/identity}
 :reaction/object+key {:db/valueType :db.type/tuple :db/tupleAttrs [:reaction/object :reaction/key]} ;; 集計

 ;; ───────── Attachment / Poll / Tag ─────────
 :attachment/object     {:db/valueType :db.type/ref}
 :attachment/url        {:db/valueType :db.type/string}
 :attachment/media-type {:db/valueType :db.type/string}
 :attachment/blurhash   {:db/valueType :db.type/string}
 :attachment/sensitive? {:db/valueType :db.type/boolean}
 :attachment/alt        {:db/valueType :db.type/string}
 :attachment/uniq     {:db/valueType :db.type/tuple
                        :db/tupleAttrs [:attachment/object :attachment/url]
                        :db/unique :db.unique/identity}
 :attachment/width      {:db/valueType :db.type/long}
 :attachment/height     {:db/valueType :db.type/long}

 :poll/object   {:db/valueType :db.type/ref :db/unique :db.unique/identity}
 :poll/ends-at  {:db/valueType :db.type/long}
 :poll/multiple? {:db/valueType :db.type/boolean}
 :choice/poll   {:db/valueType :db.type/ref}
 :choice/title  {:db/valueType :db.type/string}
 :choice/pos    {:db/valueType :db.type/long}
 :choice/uniq   {:db/valueType :db.type/tuple
                 :db/tupleAttrs [:choice/poll :choice/pos]
                 :db/unique :db.unique/identity}
 :vote/actor    {:db/valueType :db.type/ref}
 :vote/choice   {:db/valueType :db.type/ref}
 :vote/uniq     {:db/valueType :db.type/tuple
                 :db/tupleAttrs [:vote/actor :vote/choice]
                 :db/unique :db.unique/identity}

 :tagging/tag       {:db/valueType :db.type/string} ;; 小文字に正規化
 :tagging/object    {:db/valueType :db.type/ref}
 :tagging/published {:db/valueType :db.type/long}
 :tagging/tag+published {:db/valueType :db.type/tuple :db/tupleAttrs [:tagging/tag :tagging/published]}
 :tagging/uniq      {:db/valueType :db.type/tuple
                     :db/tupleAttrs [:tagging/tag :tagging/object]
                     :db/unique :db.unique/identity}

 ;; ───────── Home(畳み込み込みの実体化。使わない間は空) ─────────
 ;; (owner, object) が identity なので、同じ投稿が別の人のブーストで再び来ても upsert で 1 件に畳まれる。
 ;; :entry/via は多値で、「BさんとCさんがブースト」はそのまま via の集合。
 ;; ホームは読み込み時に merge すると決定済み(followee の author+published と Announce を束ねる)。
 ;; したがって entry は今は使わない。畳み込みを読み込み側で済ませられなくなったときの予備。
 :entry/owner  {:db/valueType :db.type/ref}
 :entry/object {:db/valueType :db.type/ref}
 :entry/via    {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
 :entry/at     {:db/valueType :db.type/long} ;; 最後にこの投稿が現れた時刻(ページ送りのキー)
 :entry/key    {:db/valueType :db.type/tuple
                :db/tupleAttrs [:entry/owner :entry/object]
                :db/unique :db.unique/identity}
 :entry/owner+at {:db/valueType :db.type/tuple :db/tupleAttrs [:entry/owner :entry/at]}

 ;; ───────── Notification ─────────
 :notification/sid       {:db/valueType :db.type/long :db/unique :db.unique/identity} ;; API の ID(Snowflake)
 :notification/recipient {:db/valueType :db.type/ref}
 :notification/type      {:db/valueType :db.type/keyword}
 :notification/source    {:db/valueType :db.type/ref}
 :notification/from      {:db/valueType :db.type/ref}
 :notification/at        {:db/valueType :db.type/long}
 :notification/read-at   {:db/valueType :db.type/long}
 :notification/dismissed-at {:db/valueType :db.type/long}
 :notification/recipient+at {:db/valueType :db.type/tuple :db/tupleAttrs [:notification/recipient :notification/at]}

 ;; ───────── 本人の整理(ブックマーク・ピン・リスト) ─────────
 :bookmark/actor  {:db/valueType :db.type/ref}
 :bookmark/object {:db/valueType :db.type/ref}
 :bookmark/at     {:db/valueType :db.type/long}
 :bookmark/uniq   {:db/valueType :db.type/tuple
                   :db/tupleAttrs [:bookmark/actor :bookmark/object]
                   :db/unique :db.unique/identity}
 :pin/actor  {:db/valueType :db.type/ref}
 :pin/object {:db/valueType :db.type/ref}
 :pin/pos    {:db/valueType :db.type/long}
 :pin/uniq   {:db/valueType :db.type/tuple
              :db/tupleAttrs [:pin/actor :pin/object]
              :db/unique :db.unique/identity}
 :list/sid     {:db/valueType :db.type/long :db/unique :db.unique/identity} ;; Postgres の lists.id(API の ID)
 :list/owner   {:db/valueType :db.type/ref}
 :list/title   {:db/valueType :db.type/string}
 :list/members {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}

 ;; ───────── Report(掃除の保持ルールが参照する。残りは B 層) ─────────
 :report/object {:db/valueType :db.type/ref}
 :report/actor  {:db/valueType :db.type/ref}

 ;; ───────── Block / Mute / Instance ─────────
 :block/actor  {:db/valueType :db.type/ref}
 :block/target {:db/valueType :db.type/ref}
 :block/uniq   {:db/valueType :db.type/tuple
                :db/tupleAttrs [:block/actor :block/target]
                :db/unique :db.unique/identity}
 :mute/actor   {:db/valueType :db.type/ref}
 :mute/target  {:db/valueType :db.type/ref}
 :mute/expires-at {:db/valueType :db.type/long}
 :mute/uniq    {:db/valueType :db.type/tuple
                :db/tupleAttrs [:mute/actor :mute/target]
                :db/unique :db.unique/identity}

 :instance/host  {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :instance/state {:db/valueType :db.type/keyword} ;; :ok :silenced :blocked(Postgres の instance_blocks.severity)
 :instance/reason {:db/valueType :db.type/string}
 :instance/last-failure-at {:db/valueType :db.type/long}

 ;; ───────── 同期位置(ローカル操作の取り込み。Graph.Local) ─────────
 :sync/name   {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :sync/cursor {:db/valueType :db.type/long}

 ;; ───────── Local user ─────────
 :user/actor     {:db/valueType :db.type/ref :db/unique :db.unique/identity}
 :user/admin?    {:db/valueType :db.type/boolean}
 :user/languages {:db/valueType :db.type/string :db/cardinality :db.cardinality/many}

 ;; ───────── Token(ブラウザの session と OAuth の access token を一つに) ─────────
 ;; 秘密は sha256 のハッシュだけを持つ。kind で分け、:session は ip/ua を、:access は app/refresh-hash を持つ。
 ;; 持たない属性は省く(nil は書けない)。数分で消えるもの(認可コード・passkey の challenge・メールの確認コード)は
 ;; ここに置かず、メモリ(ETS)に置く約束。時刻は µs。
 ;; used-at は書くたびに LMDB へ行くので、前の値から数分たったときだけ更新する。
 :token/hash         {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :token/kind         {:db/valueType :db.type/keyword} ;; :session :access
 :token/user         {:db/valueType :db.type/ref}     ;; ローカルの actor(:user/actor を持つもの)
 :token/app          {:db/valueType :db.type/ref}     ;; :access のみ
 :token/refresh-hash {:db/valueType :db.type/string :db/unique :db.unique/identity} ;; :access のみ。回転の相手
 :token/scope        {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/many} ;; :read :write :follow :push …
 :token/expires-at   {:db/valueType :db.type/long}
 :token/revoked-at   {:db/valueType :db.type/long}
 :token/used-at      {:db/valueType :db.type/long}
 :token/created-at   {:db/valueType :db.type/long}
 :token/ip           {:db/valueType :db.type/string}  ;; :session のみ
 :token/ua           {:db/valueType :db.type/string}  ;; :session のみ

 ;; ───────── OAuth アプリ ─────────
 :app/client-id    {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :app/secret-hash  {:db/valueType :db.type/string}
 :app/name         {:db/valueType :db.type/string}
 :app/redirect-uri {:db/valueType :db.type/string}
 :app/scope        {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
 :app/website      {:db/valueType :db.type/string}
 :app/owner        {:db/valueType :db.type/ref}
 :app/created-at   {:db/valueType :db.type/long}

 ;; ───────── Passkey(WebAuthn の資格情報) ─────────
 :passkey/cred-id    {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :passkey/user       {:db/valueType :db.type/ref}
 :passkey/cose-key   {:db/valueType :db.type/bytes}
 :passkey/sign-count {:db/valueType :db.type/long}
 :passkey/nickname   {:db/valueType :db.type/string}
 :passkey/used-at    {:db/valueType :db.type/long}
 :passkey/created-at {:db/valueType :db.type/long}

 ;; ───────── Web Push の購読 ─────────
 ;; alert は有効な通知の種類の集合(今の alerts の {"follow": true, …} を「真のものだけ」にした形)。
 :push/user     {:db/valueType :db.type/ref}
 :push/endpoint {:db/valueType :db.type/string}
 :push/uniq     {:db/valueType :db.type/tuple
                 :db/tupleAttrs [:push/user :push/endpoint]
                 :db/unique :db.unique/identity}
 :push/p256dh   {:db/valueType :db.type/string}
 :push/auth     {:db/valueType :db.type/string}
 :push/alert    {:db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}

 ;; ───────── 表にせず、持ち主の属性や線にしたもの ─────────
 ;; Postgres では別の表と外部キーでしか言えなかったものを、すでにある entity の属性や多値の ref にした。
 ;; 溶かさなかったもの(理由): account_deletions(終わるとアカウントごと消えるので、持ち主に付けると記録も消える),
 ;; quote_authorizations(AP の object なので Graph の object 側で),
 ;; metric_samples / outbound_events / delivery_receipts / inbound_events / note_cleanup_ledger(Datalog に入れない・重なる)。

 ;; ── 招待コード。使った人は線(invite_code_uses は used_at を誰も読まないので落とした。uses_count は数えれば出る)
 :invite/code        {:db/valueType :db.type/string :db/unique :db.unique/identity}
 :invite/issued-by   {:db/valueType :db.type/ref}
 :invite/on-behalf-of {:db/valueType :db.type/ref}
 :invite/note        {:db/valueType :db.type/string}
 :invite/max-uses    {:db/valueType :db.type/long}
 :invite/expires-at  {:db/valueType :db.type/long}
 :invite/used-by     {:db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
