---
// SPDX-License-Identifier: AGPL-3.0-or-later
import { copy, ORG_URL, ATFEDI_URL, type Locale } from '../content';
interface Props {
  locale: Locale;
}
const c = copy[Astro.props.locale];
---

<section id="org">
  <h2>{c.orgHeading}</h2>
  <p>{c.orgText}</p>
  <ul class="cards">
    {
      c.projects.map((p) => (
        <li>
          <a href={p.href}>
            <strong>{p.name}</strong>
            <span>{p.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p><a class="more" href={ORG_URL}>{c.orgLink} →</a></p>
</section>

<section id="atfedi">
  <h2>{c.atfediHeading}</h2>
  {c.atfediText.map((t) => <p>{t}</p>)}
  <ul class="facts">
    {c.atfediFacts.map((f) => <li>{f}</li>)}
  </ul>
  <p><a class="more" href={ATFEDI_URL}>{c.atfediLink} →</a></p>
</section>
