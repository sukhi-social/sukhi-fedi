{
  "name": "sukhi-fedi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "twemoji": "node scripts/copy-twemoji.mjs",
    "prebuild": "node scripts/copy-twemoji.mjs",
    "predev": "node scripts/copy-twemoji.mjs",
    "build": "vite build",
    "postbuild": "node scripts/static-manifest.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
