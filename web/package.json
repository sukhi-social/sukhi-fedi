    "shots": "pnpm run build && node shots/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.9.9",
    "budoux": "^0.8.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@twemoji/api": "^17.0.3",
    "@twemoji/svg": "^15.0.0",
    "js.foresight": "^4.2.1",
    "uqr": "^0.1.3"
